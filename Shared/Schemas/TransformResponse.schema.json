{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentype.local/schemas/transform-response.schema.json",
  "title": "OpenType Transform Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "effectiveMode",
    "text",
    "processingPath"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "effectiveMode": {
      "enum": [
        "smartEdit",
        "selectedEdit",
        "english",
        "agent",
        "xReply",
        "transcribe"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "processingPath": {
      "enum": [
        "local",
        "model",
        "fallback"
      ]
    }
  }
}
